{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gestures (dry run)",
            "type": "debugpy",
            "request": "launch",
            "module": "tv_air_remote",
            "args": ["--dry-run"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Full run (TV)",
            "type": "debugpy",
            "request": "launch",
            "module": "tv_air_remote",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "TV connection check",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/tv_check.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "TV connection check + KEY_MUTE",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/tv_check.py",
            "args": ["--key", "KEY_MUTE"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
